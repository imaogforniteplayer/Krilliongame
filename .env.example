# DEEPER currently runs fully in local demo mode and needs no credentials.
# These are reserved for the planned Supabase backend (see README "Backend status").
# Only ever put the *anon* key in browser env vars. Never commit service-role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base path when deploying to a GitHub Pages project site, e.g. /Krilliongame/
VITE_BASE=/
