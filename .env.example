# DEEPER runs fully in local demo mode with these left empty.
# Fill both in to switch on Google sign-in, email accounts and cloud backup (see docs/AUTH.md).
# Only ever put the *anon* key in browser env vars. Never commit service-role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base path when deploying to a GitHub Pages project site, e.g. /Krilliongame/
VITE_BASE=/
